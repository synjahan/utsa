{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utsa:contribution:1.0",
  "title": "Utsa shared contribution v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "type": {
          "enum": [
            "person",
            "agent",
            "project",
            "idea",
            "knowledge",
            "resource"
          ]
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "container": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,199}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "container",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "need",
        "offer",
        "interest",
        "signal"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "capability_evidence": {
      "enum": [
        "confirmed",
        "uncertain"
      ]
    },
    "verbatim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "permitted_summary": {
      "type": "string",
      "maxLength": 1000
    },
    "action": {
      "type": "string",
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "fresh_until": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        },
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "confirmed",
        "from",
        "until",
        "hours"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "remote",
            "onsite",
            "either"
          ]
        },
        "terms": {
          "enum": [
            "volunteer",
            "paid",
            "either"
          ]
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 64
        }
      },
      "required": [
        "mode",
        "terms",
        "unresolved"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "owner",
    "entity",
    "origin",
    "kind",
    "domain",
    "topics",
    "requires",
    "provides",
    "capability_evidence",
    "verbatim",
    "permitted_summary",
    "action",
    "created_at",
    "valid_from",
    "valid_until",
    "fresh_until",
    "status",
    "availability",
    "conditions"
  ],
  "additionalProperties": false
}
